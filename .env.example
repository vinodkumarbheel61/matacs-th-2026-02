# Environment Configuration Template
# Copy to .env and configure your local settings. Do NOT commit actual API keys.

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Service Settings
PORT=8080
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=25

# Database Settings (Audit Trail & Dynamic Criteria Storage)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=matacs_triage
DB_USER=triage_admin
DB_PASSWORD=your_db_password_here
